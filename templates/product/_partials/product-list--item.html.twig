<div class="card col-md-3 col-sm-6 py-2 product-list__item">
    <img src="{{ asset('uploads/p-imgs/') }}{{ product.image }}"
         class="card-img-top img-fluid" alt="{{ product.name }}">
    <div class="card-body p-0">
        <h2 class="card-title h6">
            <a class="text-decoration-none text-black" href="{{ path('app_product',{slug:product.slug}) }}">{{ product.name }}</a>
        </h2>
        <p class="h6 text-primary">{{ product.PriceWithTaxe|price_fromat }}</p>
        <a href="{{ path('app_cart_dd',{id:product.id}) }}" class="btn btn-light w-100 fw-medium">Ajouter au panier</a>
    </div>
</div>