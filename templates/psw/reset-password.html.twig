{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié{% endblock %}
{% block body %}
    <div class="container py-4">
        <h1 class="py-4">Mot de passe oublié</h1>
        <div class="form-container">
             {{ form(forgotPassForm) }}
        </div>
        <div class="container">
            <div class="row">

                <div class="py-0">
                    <p>J'ai déjà un compte</p>
                    <a href="{{ path('app_login') }}">Connexion</a>
                </div>
                <div class="py-0">
                    <p>Je crée un compte</p>
                    <a href="{{ path('app_register') }}">Créer mon compte</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
