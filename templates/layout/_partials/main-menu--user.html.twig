<div class="speed-menu">
    {% if app.user %}
        <a href="{{ path('app_account') }}" class="text-white text-decoration-none"><i data-feather="user"></i>
            <span>{{ app.user.firstname }}</span>
        </a>
    {% else %}
        <a href="{{ path('app_login') }}"><i data-feather="user"></i></a>
    {% endif %}
    <a href="{{ path('app_cart') }}" class="position-relative">
        <i data-feather="shopping-cart"></i>
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-secondary">
            {{ cartQty }}
        </span>
    </a>
</div>