<div class="d-flex justify-content-between align-items-center gap-3">

    {% if app.user %}
        <a href="{{ path('app_account') }}" class="text-white text-decoration-none d-flex align-items-center gap-1"><i data-feather="user"></i>
            <span>{{ app.user.firstname }}</span>
        </a>
        <a href="{{ path('app_account_wishlist') }}" class="text-white"> <i data-feather="heart"></i></a>
    {% else %}
        <a href="{{ path('app_login') }}" class="text-white"><i data-feather="user"></i></a>
    {% endif %}

    <a href="{{ path('app_cart') }}" class="position-relative text-white">
        <i data-feather="shopping-cart"></i>
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-secondary">
            {{ cartQty }}
        </span>
    </a>
</div>