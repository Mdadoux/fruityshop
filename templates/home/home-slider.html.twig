<div id="home-slider" class="carousel slide my-4" data-bs-ride="carousel">
    {% if sliders|length > 1 %}
        <div class="carousel-indicators">
            {% for slide in sliders %}
                <button type="button" data-bs-target="#home-slider" data-bs-slide-to="{{ loop.index0}}"
                        {% if loop.index0 ==0 %}class="active"{% endif %} aria-current="true"
                        aria-label="Slide {{ loop.index0 }}"></button>
            {% endfor %}
        </div>
    {% endif %}
    <div class="carousel-inner">
        {% for key, slide in sliders %}
            <div class="carousel-item {% if key == 0 %}active{% endif %}">
                {% include 'layout/custom-tpl/images-tpl.html.twig' with {'image':asset("uploads/home-slider/#{slide.image}"),'class':'rounded'} %}
                <div class="mw-50">
                    <div class="carousel-caption text-start text-black">
                        <h1>{{ slide.title }}</h1>
                        <p class="opacity-75">{{ slide.description|raw }}</p>
                        {% if slide.linkLabel or slide.linkTarget %}
                            <p><a class="btn btn-lg btn-primary" href="{{ slide.linkTarget }}">{{ slide.linkLabel }}</a>
                            </p>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    {% if sliders|length > 1 %}
        <button class="carousel-control-prev" type="button" data-bs-target="#home-slider" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#home-slider" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    {% endif %}
</div>



