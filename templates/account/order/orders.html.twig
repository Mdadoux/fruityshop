{% extends 'base.html.twig' %}
{% block title %}Mes commandes{% endblock %}
{% block body %}
    <div class="container my-3 account-main">
        <div class="row">
            <div class="col-md-3 sm-12 sm-12">
                {% include 'account/account-sidbar.html.twig' %}
            </div>
            <div class="col-md-9 sm-12">
                <div class="account-main__content">
                    <h1 class="fs-4">Mes commandes</h1>
                    {% if orders|length ==0 %}
                        <div class="text-center mb-3 pt-5">
                            <span class="bg-primary fw-bold order-success__icon"> <i
                                        data-feather="shopping-bag"></i> </span>
                            <h3 class="mb-3"> Aucune commande</h3>
                            <a href="{{ path('app_home') }}" class="btn btn-outline-primary">Faire ma première
                                commande</a>
                            <div class="mt-3">Retrouvez ici la liste de vos derniers achats</div>
                        </div>
                    {% else %}
                        <div class="card">
                            <div class="card-body">
                                <header class="account-order__list--isHeading account-order__list">
                                    <div class="account-order__item">ID</div>
                                    <div class="account-order__item">Date</div>
                                    <div class="account-order__item">Status</div>
                                    <div class="account-order__item">Transporteur</div>
                                    <div class="account-order__item">Total</div>
                                    <div class="account-order__item">Actions</div>
                                </header>
                                <div class="account-order__wrapper">
                                    {% for order in orders %}
                                        <div class="account-order__list">
                                            <div class="account-order__item"># <b>{{ order.id }}</b></div>
                                            <div class="account-order__item">{{ order.createdAt|date('d M y') }}</div>
                                            <div class="account-order__item">
                                                {% include 'admin/order/order-states.html.twig' with {field:{'value':order.state}} %}
                                            </div>
                                            <div class="account-order__item">DpD</div>
                                            <div class="account-order__item">40€</div>
                                            <div class="account-order__item account-order__item--isActions">
                                                <div class="account-order__actions">
                                                    <a href=""> <i data-feather="file-text"></i></a>
                                                    <a href="{{ path('app_account_order_show',{id_order:order.id}) }}"> <i data-feather="eye"></i></a>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
