{#  L'utilisateur est connecté #}
{% if  app.user %}
    {% if product in app.user.wishlists %}
        {# le produit est dejà dans la wishlist #}
        <a href="{{ path('app_account_wishlist_remove',{id:product.id}) }}"
           class="wishlist-btn wishlist-btn--isSelected btn btn-outline">
            <i data-feather="heart"></i>
        </a>
    {% else %}
        <a href="{{ path('app_account_wishlist_add',{id:product.id}) }}"
           class="wishlist-btn btn btn-outline"> <i data-feather="heart"></i>
        </a>
    {% endif %}
{% else %}
    <a data-bs-toggle="collapse" href="#wishlist-panel-{{ product.id }}" role="button" aria-expanded="false"
       aria-controls="wishlist-panel" class="wishlist-btn btn btn-outline">
        <i data-feather="heart"></i>
    </a>
{% endif %}
<div id="wishlist-panel-{{ product.id }}" class="wishlist-panel collapse mt-2 text-center" style="max-width: 400px;">
    <div class="card card-body">
        <p>Vous devez être connecté pour utiliser cette fonctionnalité !</p>
        <div class="d-flex justify-content-between align-items-center">
            <div class="p-2">
                <a href="{{ path('app_login') }}">Me connecter</a>
            </div>
            <span>OU</span>
            <div class="p-2">
                <a href="{{ path('app_register') }}">Je cree un compte</a>
            </div>
        </div>
    </div>
</div>

