{% extends 'base.html.twig' %}

{% block title %}Commande confirmée 🎉 ! {% endblock %}

{% block body %}
    <div class="confirmation-success-container bg-light" style="min-height: 100vh">
        <div class="small-container m-auto pt-5" style="max-width: 760px; margin: auto;">
            <div class="row">
                <header class="text-center mb-3 pt-5 order-success__heading">
                    <span class="bg-primary fw-bold order-success__icon"> <i data-feather="check"></i> </span>
                    <h3 class="mb-3"> Commande confirmée !</h3>
                    <a href="{{ path('app_home') }}" class="btn">Continuer mon shopping</a>
                    <div class="mt-3">Votre commande sera expédiée dans les meilleurs délais !</div>
                </header>
                <div class="card p-0">
                    <div class="card-header order-success__header">
                        <div class="row justify-content-between align-items-center pt-2">
                            <div class="col-xs-12 col-md-8">
                                <div class="text-white">
                                    <span class="card-title fw-semibold text-white fs-5">N° commande : {{ order.id }}</span>
                                    <span class="d-block">Date : {{ order.createdAt|date("d M Y") }}</span>
                                </div>
                                <span class="fw-light text-white">Un mail de confirmation a été envoyé à l'adresse suivante : <span
                                            class="text-secondary">booboolover@gspa.com</span></span>
                            </div>
                            <div class="col-xs-12 col-md-4 text-end">
                                <a href="" class="btn order-success__btn-facture fw-medium">Télécharger la facture</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">

                        {% for product in order.orderDetails %}
                            <div class="d-flex align-items-center gap-2 py-2 border-top">
                                <div class="col-3" style="max-width: 70px;">
                                    <img src="{{ asset('uploads/p-imgs/') }}{{ product.productImage }}" alt=""
                                         class="border rounded img-fluid">
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="fs-7">{{ product.productName }}</h6>
                                </div>
                                <div class="col-3 text-end" style="max-width: 120px;">
                                    <h6 class="fs-7">{{ product.productPrice|price_fromat }}</h6>
                                    <span>x {{ product.productQty }}</span>
                                </div>
                            </div>
                        {% endfor %}
                        <div class="d-flex justify-content-between align-items-start border-bottom border-top py-3 order-success__mod-list">
                            <div class="col-4 d-flex align-items-start">
                                <i data-feather="credit-card"></i>
                                <div class="text-start">
                                    <h6 class="mb-0"> Payement</h6>
                                    <span class="p-0">-</span>
                                </div>
                            </div>
                            <div class="col-4 d-flex align-items-start">
                                <i data-feather="home"></i>
                                <div class="text-start">
                                    <h6 class="mb-0"> Adresse de livraison </h6>
                                    <span class="p-0 fs-7">{{ order.delivery|raw }}</span>
                                </div>
                            </div>
                            <div class="col-4 d-flex align-items-start">
                                <i data-feather="truck"></i>
                                <div class="text-start">
                                    <h6 class="mb-0">Transporteur</h6>
                                    <span class="p-0">{{ order.carrierName }}</span>
                                    <span class="d-block fs-7 fw-semibold">{{ order.carrierPrice|price_fromat }}</span>
                                </div>

                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-sm-start">
                            <div class="col-7 py-2">
                                <h6>Besoin d'aide ?</h6>
                                <a href="" class="order-success__help text-decoration-none fw-semibold"> <i
                                            data-feather="mail"></i> Contactez nous</a>
                                <span class="d-block my-2 order-success__help fw-semibold"><i data-feather="phone"></i> 0497555</span>
                            </div>
                            <div class="col-5">
                                <div class="d-flex justify-content-between align-items-center py-2 text-color-light">
                                    <span>Total produit</span>
                                    <span class="fw-medium">{{ (order.getTotalTaxeIncl - order.carrierPrice)|price_fromat }}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center py-2 text-color-light">
                                    <span>Livraison</span>
                                    <span class="fw-medium">{{ order.carrierPrice|price_fromat }}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center py-2 text-color-light">
                                    <span>Tva</span>
                                    <span class="fw-medium">{{ order.getTotalTva|price_fromat }}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center border-top pt-3">
                                    <span class="fw-medium">Total</span>
                                    <span class="fw-bold fs-5">{{order.getTotalTaxeIncl|price_fromat}} </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

{% endblock %}
