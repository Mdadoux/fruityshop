<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Facture</title>
    <style>
        body {
            font-family: 'Roboto', sans-serif;
        }
    </style>
</head>
<body>
<div class="container" id="invoice-wrapper">
    <table class="invoice-header" style="border-bottom: 1px solid #6e6e6e;margin:auto; width: 100%;">
        <tbody>
        <tr>
            <td style="width: 45%">
                <div class="invoice-header__item" style="width: 100%">
                    <div class="invoice-header__logo">
                        <img src="data:image/svg+xml;base64,"
                             alt="">
                    </div>
                    <p style="font-size: 14px;">Socité Frutiy Shop : www.fruityshop.com<br>
                        258 Rue du bataillon 8960 Spring Field <br>
                        <strong style="margin-top: 10px;display: block;">07 98 45 13 60 </strong>
                    </p>

                </div>
            </td>
            <td style="width: 150px;">

            </td>
            <td style="width: 48%;">
                <div class="invoice-header__item">
                    <h4 style="margin-bottom:5px;">Adresse de livraison</h4>
                    <p style="font-size: 14px;">{{ order.delivery |raw }}</p>
                </div>
            </td>
        </tr>
        </tbody>
    </table>
    <table style="width: 100%;">
        <tbody>
        <tr>
            <td style="text-align: center">
                <h2 style="margin-bottom: 5px; font-size: 18px">Facture commande N° {{ order.id }}</h2>
                <small>{{ order.createdAt|date(' d M Y h:m') }}</small>
            </td>
        </tr>
        </tbody>
    </table>
    <table style="width: 100%;">
        <tr>
            <td style="width: 100%">
                <div class="card-body">
                    <span class="mb-2 text-uppercase small fw-medium">Total commande</span>
                    <h3 class="card-title">{{ (order.getTotalTaxeIncl)|price_fromat }}<sup>TTC</sup></h3>
                    <div class="card-text">
                        <div class="text-uppercase small fw-medium pb-2">Resume facture</div>
                        <div class="d-flex justify-content-between align-items-center">
                            <table style="width: 100%;margin-bottom: 10px;padding-bottom: 15px">
                                {% for product in order.orderDetails %}
                                    {% set coeff = 1+ (product.productTva/100) %}
                                    <tr>
                                        <td style="height: 1px"></td>
                                    </tr>
                                    <tr style="width: 100%;padding-bottom: 15px">
                                        <td style="width: 80%;">  {{ product.productQty }}
                                            x {{ product.productName }}</td>
                                        <td style="font-weight: bold;width: 200px;text-align: right;">{{ ((product.productPrice * coeff) * product.productQty)|price_fromat }}</td>
                                    </tr>
                                    <tr>
                                        <td style="height: 1px"></td>
                                    </tr>
                                {% endfor %}
                            </table>
                        </div>
                        <table style="width: 100%;padding-bottom: 10px;padding-top: 20px;border-top: 1px dashed #0000002d;">
                            <tr style="width: 100%;padding-top:30px;">
                                <td>Totale produits TTC</td>
                                <td style="width: 150px;text-align: right">{{ (order.getTotalTaxeIncl - order.carrierPrice)|price_fromat }}</td>
                            </tr>
                            <tr style="width: 100%">
                                <td>Total produits HT</td>
                                <td style="width: 150px;text-align: right">{{ ((order.getTotalTaxeIncl - order.carrierPrice) - order.getTotalTva)|price_fromat }}</td>
                            </tr>
                            <tr style="width: 100%">
                                <td>Prix Tva</td>
                                <td style="width: 150px;text-align: right">{{ order.getTotalTva|price_fromat }}</td>
                            </tr>
                            <tr style="width: 100%">
                                <td>Livraison</td>
                                <td style="width: 150px;text-align: right">{{ order.carrierPrice|price_fromat }}</td>
                            </tr>
                        </table>

                    </div>

                </div>
            </td>
        </tr>
    </table>


</div>
</body>
</html>